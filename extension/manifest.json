{
  "manifest_version": 3,
  "name": "xath Auto-Reply on Profile Click",
  "version": "1.2.0",
  "description": "Automatikus privát üzenet küldése azonnal profilkattintásra és automatikus 24/7 Render szinkronizáció.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://xath.hu/*",
    "*://*.xath.hu/*",
    "https://xat-bot-qziz.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://xath.hu/*",
        "*://*.xath.hu/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://xath.hu/*",
        "*://*.xath.hu/*"
      ],
      "js": ["content_bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "xath Auto-Reply"
  }
}
